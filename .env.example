# .env.example
#
# Ce fichier documente la structure attendue pour les secrets et chemins de
# modèles locaux futurs.
#
# Copier en .env avant de renseigner des valeurs :
#   cp .env.example .env
# .env n'est jamais commité (voir .gitignore).

# Chemins des poids Kokoro (TTS), relatifs à la racine du projet.
# Téléchargement manuel requis, cf. README section "Poids des modèles".
KOKORO_MODEL_PATH=models/kokoro/kokoro-v1.0.int8.onnx
KOKORO_VOICES_PATH=models/kokoro/voices-v1.0.bin

# Chemins des poids Qwen3-VL (description de scène), relatifs à la racine
# du projet. Téléchargement manuel requis depuis
# https://huggingface.co/Qwen/Qwen3-VL-4B-Instruct-GGUF (cf.
# docs/sessions/2026-08-10-qwen-smoketest.md).
QWEN3VL_MODEL_PATH=models/qwen3vl/Qwen3VL-4B-Instruct-Q4_K_M.gguf
QWEN3VL_MMPROJ_PATH=models/qwen3vl/mmproj-Qwen3VL-4B-Instruct-Q8_0.gguf
